# ── Local dev (pytest on WSL2) ──────────────────
PYTHONPATH=/your/absolute/path/to/medpoint-npi

# ── Database ─────────────────────────────────────
POSTGRES_USER=medpoint
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=medpoint_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Kafka ────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092